{
  "name": "@jr200-labs/xstate-duckdb",
  "version": "1.10.0",
  "description": "XState machine for DuckDB",
  "license": "MIT",
  "author": "Jayshan Raghunandan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jr200-labs/xstate-duckdb.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --write \"**/*.{ts,mjs,js,json,md,yml,yaml}\"",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test",
    "docs:build": "quarto render docs",
    "docs:preview": "quarto preview docs",
    "demo:build": "pnpm build && pnpm --dir docs/demo build",
    "demo:dev": "pnpm build && pnpm --dir docs/demo dev"
  },
  "keywords": [
    "xstate",
    "duckdb",
    "duckdb-wasm",
    "state-machine"
  ],
  "dependencies": {
    "pako": "^3.0.2",
    "xstate": "^5.33.2"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": ">=1.33.1-dev42.0 <2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "apache-arrow": ">=21 <22"
  },
  "devDependencies": {
    "@apache-arrow/ts": "^21.2.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev42.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@statelyai/inspect": "^0.7.2",
    "@types/pako": "^3.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "apache-arrow": "^21.2.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
